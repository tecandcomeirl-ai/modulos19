<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="petty_cash_book_view_list" model="ir.ui.view">
        <field name="name">petty.cash.book.list</field>
        <field name="model">petty.cash.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="total_in"/>
                <field name="total_out"/>
                <field name="balance" decoration-danger="balance &lt; 0"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="petty_cash_book_view_form" model="ir.ui.view">
        <field name="name">petty.cash.book.form</field>
        <field name="model">petty.cash.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Front Desk Cash Box"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="opening_balance"/>
                        </group>
                        <group>
                            <field name="total_in"/>
                            <field name="total_out"/>
                            <field name="balance" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" name="transactions">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="payee" optional="show"/>
                                    <field name="ref" optional="hide"/>
                                    <field name="line_type"/>
                                    <field name="amount"/>
                                    <field name="signed_amount" string="Effect" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="petty_cash_book_view_search" model="ir.ui.view">
        <field name="name">petty.cash.book.search</field>
        <field name="model">petty.cash.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="responsible_id"/>
                <filter name="my_books" string="My Cash Books"
                        domain="[('responsible_id', '=', uid)]"/>
                <group>
                    <filter name="group_responsible" string="Responsible"
                            context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_book" model="ir.actions.act_window">
        <field name="name">Cash Books</field>
        <field name="res_model">petty.cash.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first petty cash book</p>
            <p>Track cash in and cash out for a physical cash box and always know the balance on hand.</p>
        </field>
    </record>

    <menuitem id="menu_petty_cash_root" name="Petty Cash" sequence="90"
              web_icon="petty_cash_book,static/description/icon.png"/>
    <menuitem id="menu_petty_cash_book" name="Cash Books"
              parent="menu_petty_cash_root" action="action_petty_cash_book" sequence="10"/>

</odoo>
