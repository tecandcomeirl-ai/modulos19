<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cpe" model="ir.actions.report">
        <field name="name">Comprobante electrónico SUNAT</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pe_sunat_edi.report_cpe</field>
        <field name="report_file">l10n_pe_sunat_edi.report_cpe</field>
        <field name="print_report_name">'%s %s' % (object.sunat_doc_title, object.sunat_number)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cpe">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-3">
                            <h3><span t-field="o.sunat_doc_title"/></h3>
                            <h4>RUC <span t-field="o.company_id.vat"/> - <span t-field="o.sunat_number"/></h4>
                        </div>
                        <div class="row mb-3">
                            <div class="col-7">
                                <strong>Cliente:</strong> <span t-field="o.partner_id.name"/><br/>
                                <strong>Documento:</strong> <span t-field="o.partner_id.vat"/><br/>
                                <strong>Dirección:</strong> <span t-field="o.partner_id.contact_address"/>
                            </div>
                            <div class="col-5">
                                <strong>Fecha de emisión:</strong> <span t-field="o.invoice_date"/><br/>
                                <strong>Vencimiento:</strong> <span t-field="o.invoice_date_due"/><br/>
                                <strong>Moneda:</strong> <span t-field="o.currency_id.name"/>
                                <t t-if="o.sunat_doc_type in ('07','08')">
                                    <br/><strong>Documento que modifica:</strong>
                                    <span t-esc="(o.reversed_entry_id or o.debit_origin_id).sunat_number"/>
                                </t>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Descripción</th><th class="text-end">Cant.</th>
                                    <th class="text-end">V. unitario</th><th class="text-end">Importe</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="l">
                                    <td><span t-field="l.name"/></td>
                                    <td class="text-end"><span t-field="l.quantity"/></td>
                                    <td class="text-end"><span t-field="l.price_unit"/></td>
                                    <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-7">
                                <p><strong><span t-field="o.sunat_legend"/></strong></p>
                                <p t-if="o.sunat_qr_url">
                                    <img t-att-src="o.sunat_qr_url" style="width:110px;height:110px;" alt="QR"/>
                                </p>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr><td>Op. gravada / exonerada</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                                    <tr><td>IGV</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                                    <tr><td><strong>Importe total</strong></td><td class="text-end"><strong><span t-field="o.amount_total"/></strong></td></tr>
                                </table>
                            </div>
                        </div>
                        <p class="text-muted" style="font-size:10px;">
                            Representación impresa de la <span t-field="o.sunat_doc_title"/>.
                            Consulte su validez en www.sunat.gob.pe.
                            <t t-if="o.sunat_hash"><br/>Hash: <span t-field="o.sunat_hash"/></t>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
