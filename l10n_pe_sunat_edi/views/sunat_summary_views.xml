<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_summary_list" model="ir.ui.view">
        <field name="name">sunat.summary.list</field>
        <field name="model">sunat.summary</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='accepted'" decoration-danger="state in ('rejected','error')">
                <field name="name"/>
                <field name="kind"/>
                <field name="reference_date"/>
                <field name="issue_date"/>
                <field name="state"/>
                <field name="response_code"/>
            </list>
        </field>
    </record>

    <record id="view_sunat_summary_form" model="ir.ui.view">
        <field name="name">sunat.summary.form</field>
        <field name="model">sunat.summary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="Enviar a SUNAT" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_check_ticket" string="Consultar ticket" type="object"
                            invisible="state != 'sent'"/>
                    <button name="action_reset_draft" string="Volver a borrador" type="object"
                            invisible="state not in ('error','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,accepted"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="reference_date" readonly="state != 'draft'"/>
                            <field name="issue_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="ticket"/>
                            <field name="response_code"/>
                            <field name="sent_date"/>
                            <field name="xml_file" filename="name"/>
                            <field name="zip_file"/>
                            <field name="cdr_file"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comprobantes">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="move_id"/>
                                    <field name="condition"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Respuesta SUNAT">
                            <field name="response_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sunat_summary" model="ir.actions.act_window">
        <field name="name">Resúmenes y bajas</field>
        <field name="res_model">sunat.summary</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sunat_summary" name="Resúmenes y bajas" parent="l10n_pe_sunat_beta.menu_sunat_root"
              action="action_sunat_summary" sequence="25"/>
</odoo>
