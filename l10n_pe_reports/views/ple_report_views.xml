<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ple_report_list" model="ir.ui.view">
        <field name="name">l10n_pe.ple.report.list</field>
        <field name="model">l10n_pe.ple.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="book"/>
                <field name="year"/>
                <field name="month"/>
                <field name="record_count"/>
                <field name="txt_filename"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ple_report_form" model="ir.ui.view">
        <field name="name">l10n_pe.ple.report.form</field>
        <field name="model">l10n_pe.ple.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" string="Generar libro" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="book" readonly="state == 'done'"/>
                            <field name="year" readonly="state == 'done'"/>
                            <field name="month" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="record_count"/>
                            <field name="txt_file" filename="txt_filename"/>
                            <field name="txt_filename" invisible="1"/>
                            <field name="xlsx_file" filename="xlsx_filename"/>
                            <field name="xlsx_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observaciones de la generación"/>
                    <p class="text-muted">
                        Valide el TXT con el PLE oficial de SUNAT antes de generar la constancia de recepción.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ple_report" model="ir.actions.act_window">
        <field name="name">Libros electrónicos (PLE)</field>
        <field name="res_model">l10n_pe.ple.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ple_report" name="Libros electrónicos (PLE)" parent="l10n_pe_sunat_beta.menu_sunat_root"
              action="action_ple_report" sequence="70"/>

    <record id="view_company_form_ple" model="ir.ui.view">
        <field name="name">res.company.form.ple</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_pe_sunat_beta.view_company_form_sunat"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sunat']" position="inside">
                <group string="Libros electrónicos">
                    <field name="ple_sire"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
