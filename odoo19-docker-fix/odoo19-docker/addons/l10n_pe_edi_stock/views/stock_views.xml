<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_edi_stock" model="ir.ui.view">
        <field name="name">stock.picking.form.edi.stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="GRE SUNAT" name="sunat_gre">
                    <group>
                        <group string="Traslado">
                            <field name="sunat_gre_reason"/>
                            <field name="sunat_transport_mode"/>
                            <field name="sunat_packages"/>
                            <field name="sunat_gross_weight"/>
                        </group>
                        <group string="Transporte">
                            <field name="sunat_driver_id" invisible="sunat_transport_mode != '02'"/>
                            <field name="sunat_vehicle_id" invisible="sunat_transport_mode != '02'"/>
                            <field name="sunat_carrier_id" invisible="sunat_transport_mode != '01'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picking_type_form_edi_stock" model="ir.ui.view">
        <field name="name">stock.picking.type.form.edi.stock</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="sunat_auto_gre" invisible="code not in ('outgoing','internal')"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_edi_stock" model="ir.ui.view">
        <field name="name">stock.warehouse.edi.stock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="sunat_annex_code"/>
                <field name="sunat_ubigeo"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_form_edi_stock" model="ir.ui.view">
        <field name="name">product.template.form.edi.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="sunat_existence_type"/>
                <field name="sunat_unspsc_code"/>
            </field>
        </field>
    </record>
</odoo>
