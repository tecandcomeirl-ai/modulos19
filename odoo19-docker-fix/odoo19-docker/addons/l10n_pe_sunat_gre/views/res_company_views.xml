<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sunat_gre" model="ir.ui.view">
        <field name="name">res.company.form.sunat.gre</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_pe_sunat_beta.view_company_form_sunat"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sunat']" position="inside">
                <group string="Guía de Remisión Electrónica (API REST)">
                    <group>
                        <field name="sunat_gre_env"/>
                        <field name="sunat_gre_series"/>
                        <field name="sunat_gre_test_url" invisible="sunat_gre_env != 'test'"/>
                    </group>
                    <group>
                        <field name="sunat_gre_client_id"/>
                        <field name="sunat_gre_client_secret" password="True"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
