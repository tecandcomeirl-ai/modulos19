<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_sunat_gre" model="ir.ui.view">
        <field name="name">stock.picking.form.sunat.gre</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_sunat_gre" string="Generar GRE" type="object"
                        invisible="state in ('draft','cancel')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sunat_gre" type="object" class="oe_stat_button"
                        icon="fa-truck" invisible="sunat_gre_count == 0">
                    <field name="sunat_gre_count" widget="statinfo" string="GRE"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
