<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_sunat_root" name="SUNAT" sequence="95"
              groups="account.group_account_invoice"/>

    <record id="view_sunat_document_list" model="ir.ui.view">
        <field name="name">sunat.document.list</field>
        <field name="model">sunat.document</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='accepted'" decoration-danger="state in ('rejected','error')">
                <field name="name"/>
                <field name="move_id"/>
                <field name="doc_type"/>
                <field name="sunat_env"/>
                <field name="state"/>
                <field name="response_code"/>
                <field name="sent_date"/>
            </list>
        </field>
    </record>

    <record id="view_sunat_document_form" model="ir.ui.view">
        <field name="name">sunat.document.form</field>
        <field name="model">sunat.document</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_send" string="Reenviar" type="object"
                            invisible="state == 'accepted'"/>
                    <button name="action_check_ticket" string="Consultar ticket" type="object"
                            invisible="not ticket"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="move_id"/>
                            <field name="doc_type"/>
                            <field name="sunat_env"/>
                            <field name="sent_date"/>
                        </group>
                        <group>
                            <field name="response_code"/>
                            <field name="ticket"/>
                            <field name="xml_file" filename="name"/>
                            <field name="zip_file"/>
                            <field name="cdr_file"/>
                        </group>
                    </group>
                    <field name="response_message" placeholder="Respuesta de SUNAT"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunat_document_search" model="ir.ui.view">
        <field name="name">sunat.document.search</field>
        <field name="model">sunat.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="move_id"/>
                <filter name="accepted" string="Aceptados" domain="[('state','=','accepted')]"/>
                <filter name="problems" string="Rechazados / Error" domain="[('state','in',('rejected','error'))]"/>
                <group>
                    <filter name="by_type" string="Tipo" context="{'group_by':'doc_type'}"/>
                    <filter name="by_state" string="Estado" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sunat_document" model="ir.actions.act_window">
        <field name="name">Comprobantes enviados</field>
        <field name="res_model">sunat.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_sunat_nota_venta" model="ir.actions.act_window">
        <field name="name">Notas de venta</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sunat_doc_type','=','NV'),('move_type','=','out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_sunat_doc_type': 'NV'}</field>
    </record>

    <menuitem id="menu_sunat_documents" name="Comprobantes enviados" parent="menu_sunat_root"
              action="action_sunat_document" sequence="10"/>
    <menuitem id="menu_sunat_nota_venta" name="Notas de venta" parent="menu_sunat_root"
              action="action_sunat_nota_venta" sequence="20"/>
</odoo>
