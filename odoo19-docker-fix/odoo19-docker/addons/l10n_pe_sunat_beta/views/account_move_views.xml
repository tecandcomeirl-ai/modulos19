<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sunat" model="ir.ui.view">
        <field name="name">account.move.form.sunat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_sunat" string="Enviar a SUNAT" type="object" class="btn-primary"
                        invisible="state != 'posted' or move_type not in ('out_invoice','out_refund') or sunat_doc_type in (False,'NV') or sunat_state == 'accepted'"/>
                <button name="action_print_nota_venta" string="Imprimir nota de venta" type="object"
                        invisible="state != 'posted' or sunat_doc_type != 'NV'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sunat_documents" type="object" class="oe_stat_button"
                        icon="fa-cloud-upload" string="SUNAT"
                        invisible="move_type not in ('out_invoice','out_refund') or sunat_doc_type == 'NV'"/>
            </xpath>
            <field name="invoice_date" position="after">
                <field name="sunat_doc_type" invisible="move_type not in ('out_invoice','out_refund')"/>
                <field name="sunat_credit_reason" invisible="sunat_doc_type != '07'"/>
                <field name="sunat_debit_reason" invisible="sunat_doc_type != '08'"/>
                <field name="sunat_note_description" invisible="sunat_doc_type not in ('07','08')"/>
                <field name="sunat_nv_number" invisible="sunat_doc_type != 'NV'"/>
                <field name="sunat_state" widget="badge" invisible="not sunat_state"/>
            </field>
        </field>
    </record>
</odoo>
