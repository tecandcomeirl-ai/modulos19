<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_void_wizard_form" model="ir.ui.view">
        <field name="name">sunat.void.wizard.form</field>
        <field name="model">sunat.void.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="move_id"/>
                    <field name="reason"/>
                </group>
                <p class="text-muted">
                    Facturas y notas se comunican con una Comunicación de baja (RA); las boletas con un
                    Resumen diario (RC) en condición «Anular». Después deberá cancelar/revertir el asiento en Odoo.
                </p>
                <footer>
                    <button name="action_confirm" string="Dar de baja" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
