<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sunat_edi" model="ir.ui.view">
        <field name="name">account.move.form.sunat.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_void_sunat" string="Dar de baja en SUNAT" type="object"
                        invisible="state != 'posted' or sunat_state != 'accepted' or sunat_voided or sunat_doc_type in (False,'NV') or move_type not in ('out_invoice','out_refund')"/>
            </xpath>
            <field name="sunat_state" position="after">
                <field name="sunat_voided" invisible="not sunat_voided"/>
                <field name="sunat_attempts" invisible="sunat_attempts == 0"/>
            </field>
        </field>
    </record>
</odoo>
