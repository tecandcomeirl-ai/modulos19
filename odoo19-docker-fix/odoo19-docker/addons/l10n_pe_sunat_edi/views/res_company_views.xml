<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sunat_edi" model="ir.ui.view">
        <field name="name">res.company.form.sunat.edi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_pe_sunat_beta.view_company_form_sunat"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sunat']" position="inside">
                <group string="EDI automatizado">
                    <group>
                        <field name="sunat_auto_send"/>
                        <field name="sunat_boleta_mode"/>
                        <field name="sunat_max_attempts" invisible="sunat_auto_send == 'off'"/>
                    </group>
                    <group>
                        <field name="sunat_auto_mail"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
