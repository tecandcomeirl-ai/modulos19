<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ea_whatsapp_connector.QrField">
        <div class="o_ea_whatsapp_qr d-flex flex-column align-items-center gap-2 py-2">
            <div class="o_ea_whatsapp_qr_box d-flex align-items-center justify-content-center">
                <img t-if="state.qr" t-att-src="'data:image/png;base64,' + state.qr" alt="WhatsApp QR code"/>
                <i t-else="" class="fa fa-circle-o-notch fa-spin fa-2x text-muted"/>
            </div>
            <small class="text-muted text-center" t-esc="hint"/>
        </div>
    </t>
</templates>
