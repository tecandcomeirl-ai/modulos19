<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ea_whatsapp_composer_form" model="ir.ui.view">
        <field name="name">ea.whatsapp.composer.form</field>
        <field name="model">ea.whatsapp.composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <div class="alert alert-warning" role="alert" invisible="not missing_phone_ids">
                    These contacts have no phone number and will be skipped:
                    <field name="missing_phone_ids" widget="many2many_tags" readonly="1" class="d-inline"/>
                </div>
                <group>
                    <field name="account_id" options="{'no_create': True}"/>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="number" placeholder="+91 98765 43210"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <field name="body" placeholder="Type your message..." nolabel="1"/>
                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            icon="fa-paper-plane" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
