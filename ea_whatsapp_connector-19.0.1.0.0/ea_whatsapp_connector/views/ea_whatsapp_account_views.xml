<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ea_whatsapp_account_form" model="ir.ui.view">
        <field name="name">ea.whatsapp.account.form</field>
        <field name="model">ea.whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <header>
                    <button name="action_connect" type="object" string="Connect"
                            class="btn-primary" invisible="state in ('connected', 'qr', 'connecting')"/>
                    <button name="action_refresh_status" type="object" string="Refresh Status"
                            invisible="state == 'draft'"/>
                    <button name="action_logout" type="object" string="Log Out"
                            invisible="state != 'connected'"
                            confirm="This unlinks the WhatsApp number from Odoo. You will need to scan a new QR code. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,qr,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-whatsapp">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales WhatsApp"/></h1>
                    </div>

                    <div class="alert alert-success" role="status" invisible="state != 'connected'">
                        <i class="fa fa-check-circle me-1"/>
                        Connected as <strong><field name="wa_name" class="d-inline"/></strong>
                        (+<field name="phone_number" class="d-inline"/>)
                    </div>
                    <div invisible="state not in ('qr', 'connecting')" class="text-center mb-3">
                        <field name="qr_code" widget="ea_whatsapp_qr" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Gateway">
                            <field name="gateway_url"/>
                            <field name="api_key" password="True"/>
                            <field name="session_id"/>
                            <field name="callback_base_url" placeholder="Defaults to web.base.url"/>
                        </group>
                        <group string="Behaviour">
                            <field name="is_default"/>
                            <field name="auto_create_partner"/>
                            <field name="post_on_related_document"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <group string="Webhook" groups="ea_whatsapp_connector.group_ea_whatsapp_manager">
                        <field name="webhook_url" widget="CopyClipboardChar"/>
                        <div colspan="2">
                            <button name="action_regenerate_token" type="object" string="Regenerate Webhook Token"
                                    class="btn-link ps-0" icon="fa-refresh"
                                    confirm="The gateway must reconnect (press Connect) to use the new token. Continue?"/>
                        </div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ea_whatsapp_account_list" model="ir.ui.view">
        <field name="name">ea.whatsapp.account.list</field>
        <field name="model">ea.whatsapp.account</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="wa_name"/>
                <field name="is_default"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state in ('qr', 'connecting')"
                       decoration-danger="state == 'disconnected'"/>
            </list>
        </field>
    </record>

    <record id="view_ea_whatsapp_account_search" model="ir.ui.view">
        <field name="name">ea.whatsapp.account.search</field>
        <field name="model">ea.whatsapp.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone_number"/>
                <filter name="connected" string="Connected" domain="[('state', '=', 'connected')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ea_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">ea.whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first WhatsApp number</p>
            <p>Start the EA WhatsApp gateway, create an account, press <b>Connect</b>,
               then scan the QR code from WhatsApp &gt; Linked devices.</p>
        </field>
    </record>
</odoo>
