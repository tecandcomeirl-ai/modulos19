<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_sunat_gre" model="ir.sequence">
            <field name="name">SUNAT - GRE Remitente (T001)</field>
            <field name="code">sunat.gre</field>
            <field name="padding">0</field>
            <field name="number_increment">1</field>
        </record>
    </data>

    <record id="ir_cron_sunat_gre_tickets" model="ir.cron">
        <field name="name">SUNAT: consultar tickets de GRE pendientes</field>
        <field name="model_id" ref="model_sunat_gre"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_tickets()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
