<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full accounting features for accounting managers (hidden group in Community) -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="name">Accounting</field>
    </record>

    <data noupdate="1">
        <record id="seq_acc_pdc" model="ir.sequence">
            <field name="name">Post Dated Cheques</field>
            <field name="code">acc.pdc</field>
            <field name="prefix">PDC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_acc_recurring" model="ir.sequence">
            <field name="name">Recurring Entries</field>
            <field name="code">acc.recurring.entry</field>
            <field name="prefix">REC/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="ir_cron_acc_recurring" model="ir.cron">
            <field name="name">Accounting: generate recurring entries</field>
            <field name="model_id" ref="model_acc_recurring_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
