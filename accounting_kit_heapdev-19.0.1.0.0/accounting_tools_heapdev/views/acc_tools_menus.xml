<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_acc_dashboard" model="ir.actions.client">
        <field name="name">Accounting Dashboard</field>
        <field name="tag">acc_report_heapdev</field>
        <field name="params" eval="{'report': 'dashboard'}"/>
    </record>
    <menuitem id="menu_acc_dashboard" name="Overview" parent="account.menu_finance" action="action_acc_dashboard" sequence="0"
              groups="account.group_account_readonly,account.group_account_invoice"/>
    <menuitem id="menu_acc_recurring" name="Recurring Entries" parent="account.menu_finance_entries" action="action_acc_recurring" sequence="40"
              groups="account.group_account_user,account.group_account_manager"/>
    <menuitem id="menu_acc_pdc_received" name="PDC Received" parent="account.menu_finance_receivables" action="action_acc_pdc_received" sequence="80"/>
    <menuitem id="menu_acc_pdc_issued" name="PDC Issued" parent="account.menu_finance_payables" action="action_acc_pdc_issued" sequence="80"/>
    <menuitem id="menu_acc_lock_date" name="Lock Dates" parent="account.menu_finance_configuration" action="action_acc_lock_date" sequence="50"
              groups="account.group_account_manager"/>
</odoo>
