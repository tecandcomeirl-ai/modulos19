<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_pdc_list" model="ir.ui.view">
        <field name="name">acc.pdc.list</field>
        <field name="model">acc.pdc</field>
        <field name="arch" type="xml">
            <list string="Post Dated Cheques" decoration-danger="state == 'bounced'" decoration-muted="state in ('cleared', 'cancel')"
                    decoration-warning="state in ('registered', 'deposited') and days_to_maturity &lt;= 7">
                <field name="name"/>
                <field name="pdc_type" optional="show"/>
                <field name="partner_id"/>
                <field name="cheque_number"/>
                <field name="bank_name" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="cheque_date"/>
                <field name="days_to_maturity" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'cleared'" decoration-info="state in ('registered', 'deposited')" decoration-danger="state == 'bounced'"/>
            </list>
        </field>
    </record>

    <record id="view_acc_pdc_form" model="ir.ui.view">
        <field name="name">acc.pdc.form</field>
        <field name="model">acc.pdc</field>
        <field name="arch" type="xml">
            <form string="Post Dated Cheque">
                <header>
                    <button name="action_register" type="object" string="Register" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_deposit" type="object" string="Deposit" invisible="state != 'registered' or pdc_type != 'receive'"/>
                    <button name="action_clear" type="object" string="Clear" class="btn-primary" invisible="state not in ('registered', 'deposited')"/>
                    <button name="action_bounce" type="object" string="Bounce" invisible="state not in ('registered', 'deposited')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,registered,deposited,cleared"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="state in ('draft', 'cancel')">
                            <span>Entries</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pdc_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="cheque_number" readonly="state != 'draft'"/>
                            <field name="bank_name"/>
                            <field name="memo"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="cheque_date" readonly="state not in ('draft', 'registered')"/>
                            <field name="days_to_maturity" invisible="state not in ('registered', 'deposited')"/>
                            <field name="journal_id" readonly="state in ('cleared', 'bounced')"/>
                            <field name="misc_journal_id" readonly="state != 'draft'"/>
                            <field name="pdc_account_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoices / Bills" name="invoices">
                            <field name="invoice_ids" readonly="state != 'draft'"
                                   domain="[('partner_id', 'child_of', partner_id), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('move_type', 'in', ('out_invoice', 'in_invoice'))]">
                                <list>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="state" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Entries" name="entries" invisible="state in ('draft', 'cancel')">
                            <group>
                                <field name="register_move_id"/>
                                <field name="clear_move_id" invisible="not clear_move_id"/>
                                <field name="bounce_move_id" invisible="not bounce_move_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acc_pdc_search" model="ir.ui.view">
        <field name="name">acc.pdc.search</field>
        <field name="model">acc.pdc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="cheque_number"/>
                <filter name="in_hand" string="In Hand" domain="[('state', 'in', ('registered', 'deposited'))]"/>
                <filter name="cleared" string="Cleared" domain="[('state', '=', 'cleared')]"/>
                <filter name="bounced" string="Bounced" domain="[('state', '=', 'bounced')]"/>
                <separator/>
                <filter name="filter_cheque_date" string="Cheque Date" date="cheque_date"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Maturity Month" context="{'group_by': 'cheque_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_acc_pdc_received" model="ir.actions.act_window">
        <field name="name">PDC Received</field>
        <field name="res_model">acc.pdc</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pdc_type', '=', 'receive')]</field>
        <field name="context">{'default_pdc_type': 'receive', 'search_default_in_hand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a post dated cheque received from a customer</p>
        </field>
    </record>
    <record id="action_acc_pdc_issued" model="ir.actions.act_window">
        <field name="name">PDC Issued</field>
        <field name="res_model">acc.pdc</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pdc_type', '=', 'issue')]</field>
        <field name="context">{'default_pdc_type': 'issue', 'search_default_in_hand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a post dated cheque issued to a vendor</p>
        </field>
    </record>
</odoo>
