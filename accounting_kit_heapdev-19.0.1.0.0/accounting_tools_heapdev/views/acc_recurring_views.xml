<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_recurring_list" model="ir.ui.view">
        <field name="name">acc.recurring.entry.list</field>
        <field name="model">acc.recurring.entry</field>
        <field name="arch" type="xml">
            <list string="Recurring Entries" decoration-muted="state in ('done', 'stopped')">
                <field name="code"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="interval_number" string="Every"/>
                <field name="interval_type" string="Period"/>
                <field name="next_date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_debit" string="Amount"/>
                <field name="move_count" string="Entries"/>
                <field name="state" widget="badge" decoration-success="state == 'running'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_acc_recurring_form" model="ir.ui.view">
        <field name="name">acc.recurring.entry.form</field>
        <field name="model">acc.recurring.entry</field>
        <field name="arch" type="xml">
            <form string="Recurring Entry">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('draft', 'stopped')"/>
                    <button name="action_generate_now" type="object" string="Generate Due Entries" class="btn-primary" invisible="state != 'running'"/>
                    <button name="action_stop" type="object" string="Stop" invisible="state != 'running'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('stopped', 'done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <field name="code" readonly="1"/>
                        <h1><field name="name" placeholder="e.g. Monthly office rent accrual"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="journal_id" readonly="state == 'running'"/>
                            <field name="partner_id"/>
                            <field name="ref"/>
                            <field name="auto_post"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <label for="interval_number" string="Repeat Every"/>
                            <div class="o_row">
                                <field name="interval_number" readonly="state == 'running'"/>
                                <field name="interval_type" readonly="state == 'running'"/>
                            </div>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="next_date"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal Items" name="lines">
                            <field name="line_ids" readonly="state == 'running'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="account_id"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="debit" sum="Total"/>
                                    <field name="credit" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_debit"/>
                                <field name="total_credit"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acc_recurring_search" model="ir.ui.view">
        <field name="name">acc.recurring.entry.search</field>
        <field name="model">acc.recurring.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="stopped" string="Stopped / Finished" domain="[('state', 'in', ('stopped', 'done'))]"/>
            </search>
        </field>
    </record>

    <record id="action_acc_recurring" model="ir.actions.act_window">
        <field name="name">Recurring Entries</field>
        <field name="res_model">acc.recurring.entry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a recurring journal entry</p>
            <p>Rent, accruals, prepaid amortisation or management fees posted automatically every period.</p>
        </field>
    </record>
</odoo>
