<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_acc_tools" model="ir.ui.view">
        <field name="name">res.company.form.acc.tools</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Accounting Kit" name="acc_tools" groups="account.group_account_manager">
                    <group string="Post Dated Cheques">
                        <field name="acc_pdc_receivable_account_id"/>
                        <field name="acc_pdc_payable_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
