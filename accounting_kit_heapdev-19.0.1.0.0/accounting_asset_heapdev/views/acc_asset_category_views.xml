<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_asset_category_list" model="ir.ui.view">
        <field name="name">acc.asset.category.list</field>
        <field name="model">acc.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="asset_type"/>
                <field name="method"/>
                <field name="method_number"/>
                <field name="method_period"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_acc_asset_category_form" model="ir.ui.view">
        <field name="name">acc.asset.category.form</field>
        <field name="model">acc.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Motor Vehicles"/></h1>
                    </div>
                    <group>
                        <group string="Accounting">
                            <field name="asset_type"/>
                            <field name="journal_id"/>
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Depreciation / Recognition">
                            <field name="method" invisible="asset_type != 'asset'"/>
                            <field name="degressive_factor" invisible="method != 'degressive'"/>
                            <field name="method_number"/>
                            <field name="method_period"/>
                            <field name="prorata"/>
                        </group>
                        <group string="Automation">
                            <field name="auto_create"/>
                            <field name="auto_confirm"/>
                            <field name="auto_post"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acc_asset_category_search" model="ir.ui.view">
        <field name="name">acc.asset.category.search</field>
        <field name="model">acc.asset.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="type_asset" string="Fixed Assets" domain="[('asset_type', '=', 'asset')]"/>
                <filter name="type_expense" string="Deferred Expenses" domain="[('asset_type', '=', 'expense')]"/>
                <filter name="type_revenue" string="Deferred Revenues" domain="[('asset_type', '=', 'revenue')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'asset_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_acc_asset_category" model="ir.actions.act_window">
        <field name="name">Asset &amp; Deferral Categories</field>
        <field name="res_model">acc.asset.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an asset or deferral category</p>
            <p>Categories hold the accounts, journal and depreciation method used by assets, deferred revenues and deferred expenses.</p>
        </field>
    </record>
</odoo>
