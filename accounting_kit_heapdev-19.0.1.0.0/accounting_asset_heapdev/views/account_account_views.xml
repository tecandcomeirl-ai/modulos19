<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_acc_asset" model="ir.ui.view">
        <field name="name">account.account.form.acc.asset</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="acc_asset" string="Assets &amp; Deferrals">
                    <field name="acc_asset_category_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_acc_asset" model="ir.ui.view">
        <field name="name">account.move.form.acc.asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="acc_created_asset_count" invisible="1"/>
                <button name="action_view_acc_assets" type="object" class="oe_stat_button" icon="fa-cubes" invisible="acc_created_asset_count == 0">
                    <field name="acc_created_asset_count" widget="statinfo" string="Assets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
