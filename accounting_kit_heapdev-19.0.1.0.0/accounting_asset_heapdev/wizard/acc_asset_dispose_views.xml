<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_asset_dispose_form" model="ir.ui.view">
        <field name="name">acc.asset.dispose.form</field>
        <field name="model">acc.asset.dispose</field>
        <field name="arch" type="xml">
            <form string="Dispose / Sell Asset">
                <group>
                    <group>
                        <field name="asset_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="action" widget="radio"/>
                        <field name="date"/>
                        <field name="post_depreciation"/>
                    </group>
                    <group>
                        <field name="sale_value" invisible="action != 'sell'"/>
                        <field name="proceeds_account_id" invisible="action != 'sell'" required="action == 'sell'"/>
                        <field name="gain_account_id"/>
                        <field name="loss_account_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
