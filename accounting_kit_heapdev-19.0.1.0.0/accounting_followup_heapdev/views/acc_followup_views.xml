<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acc_followup_level_list" model="ir.ui.view">
        <field name="name">acc.followup.level.list</field>
        <field name="model">acc.followup.level</field>
        <field name="arch" type="xml">
            <list string="Follow-up Levels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="delay"/>
                <field name="send_email"/>
                <field name="print_letter"/>
                <field name="manual_action"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_acc_followup_level_form" model="ir.ui.view">
        <field name="name">acc.followup.level.form</field>
        <field name="model">acc.followup.level</field>
        <field name="arch" type="xml">
            <form string="Follow-up Level">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. First reminder"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="delay"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="send_email"/>
                            <field name="print_letter"/>
                            <field name="manual_action"/>
                            <field name="manual_action_note" invisible="not manual_action"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description" placeholder="Dear {partner}, ..."/>
                    <p class="text-muted">Placeholders: {partner}, {company}, {total_due}, {total_overdue}, {date}</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_acc_followup_level" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">acc.followup.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_partner_acc_followup_list" model="ir.ui.view">
        <field name="name">res.partner.acc.followup.list</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Customer Follow-up" create="0" decoration-danger="acc_overdue_days &gt; 60" decoration-warning="acc_overdue_days &gt; 30 and acc_overdue_days &lt;= 60">
                <field name="name"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="acc_currency_id" column_invisible="True"/>
                <field name="acc_total_due"/>
                <field name="acc_total_overdue"/>
                <field name="acc_overdue_days"/>
                <field name="acc_followup_level_id"/>
                <field name="acc_followup_last_date" optional="show"/>
                <field name="acc_followup_next_date" optional="show"/>
                <field name="acc_followup_responsible_id" optional="hide"/>
                <button name="action_acc_followup_email" type="object" icon="fa-envelope" title="Send reminder"/>
                <button name="action_acc_print_statement" type="object" icon="fa-print" title="Print statement"/>
            </list>
        </field>
    </record>

    <record id="view_partner_acc_followup_search" model="ir.ui.view">
        <field name="name">res.partner.acc.followup.search</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="acc_followup_responsible_id"/>
                <filter name="overdue" string="Overdue" domain="[('acc_has_overdue', '=', True)]"/>
                <filter name="due" string="With Open Balance" domain="[('acc_has_due', '=', True)]"/>
                <filter name="to_do" string="Action Due" domain="['|', ('acc_followup_next_date', '=', False), ('acc_followup_next_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="My Follow-ups" domain="[('acc_followup_responsible_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_acc_followup_partners" model="ir.actions.act_window">
        <field name="name">Customer Follow-up</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_partner_acc_followup_search"/>
        <field name="domain">[('acc_has_due', '=', True), ('parent_id', '=', False)]</field>
        <field name="context">{'search_default_overdue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No overdue customer</p>
            <p>Customers with overdue invoices appear here with their follow-up level.</p>
        </field>
    </record>
    <record id="action_acc_followup_partners_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_acc_followup_list"/>
        <field name="act_window_id" ref="action_acc_followup_partners"/>
    </record>

    <record id="view_partner_form_acc_followup" model="ir.ui.view">
        <field name="name">res.partner.form.acc.followup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Follow-up" name="acc_followup" groups="account.group_account_invoice" invisible="parent_id">
                    <group>
                        <group>
                            <field name="acc_currency_id" invisible="1"/>
                            <field name="acc_total_due"/>
                            <field name="acc_total_overdue"/>
                            <field name="acc_overdue_days"/>
                            <field name="acc_followup_level_id"/>
                        </group>
                        <group>
                            <field name="acc_followup_responsible_id"/>
                            <field name="acc_followup_last_date"/>
                            <field name="acc_followup_next_date"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_acc_followup_email" type="object" string="Send Reminder" class="btn-primary" icon="fa-envelope"/>
                        <button name="action_acc_print_statement" type="object" string="Print Statement" class="btn-secondary ms-2" icon="fa-print"/>
                        <button name="action_acc_done" type="object" string="Mark Followed" class="btn-secondary ms-2" icon="fa-check"/>
                    </div>
                    <field name="acc_followup_note" placeholder="Promise to pay, disputes, call notes..."/>
                    <field name="acc_open_aml_ids" readonly="1">
                        <list decoration-danger="date_maturity and date_maturity &lt; current_date">
                            <field name="date"/>
                            <field name="move_id"/>
                            <field name="name"/>
                            <field name="date_maturity"/>
                            <field name="balance" string="Amount"/>
                            <field name="amount_residual" string="Open" sum="Total"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_acc_followup" name="Customer Follow-up" parent="account.menu_finance_receivables" action="action_acc_followup_partners" sequence="90"/>
    <menuitem id="menu_acc_followup_run" name="Run Follow-ups" parent="account.menu_finance_receivables" action="action_acc_followup_run" sequence="91"/>
    <menuitem id="menu_acc_followup_level" name="Follow-up Levels" parent="account.menu_finance_configuration" action="action_acc_followup_level" sequence="45" groups="account.group_account_manager"/>
</odoo>
