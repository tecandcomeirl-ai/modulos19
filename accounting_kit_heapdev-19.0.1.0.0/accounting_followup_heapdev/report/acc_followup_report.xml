<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_acc_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">accounting_followup_heapdev.report_acc_customer_statement</field>
        <field name="report_file">accounting_followup_heapdev.report_acc_customer_statement</field>
        <field name="print_report_name">'Statement - %s' % (object.name)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_acc_customer_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="vals" t-value="o._acc_statement_values()"/>
                <t t-set="cur" t-value="o.env.company.currency_id"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 12px;">
                        <table style="width: 100%; margin-bottom: 14px;">
                            <tr>
                                <td style="width: 55%; vertical-align: top;">
                                    <h3 style="margin: 0;">Statement of Account <span style="color: #6b7a8c;">| كشف حساب</span></h3>
                                    <div style="color: #6b7a8c;">As of <t t-out="vals['today']"/> · <span>كما في</span> <t t-out="vals['today']"/></div>
                                </td>
                                <td style="vertical-align: top; text-align: right;">
                                    <strong t-out="o.name"/><br/>
                                    <t t-if="o.street"><t t-out="o.street"/><br/></t>
                                    <t t-if="o.city"><t t-out="o.city"/> <t t-out="o.country_id.name or ''"/><br/></t>
                                    <t t-if="o.vat">TRN / الرقم الضريبي: <t t-out="o.vat"/></t>
                                </td>
                            </tr>
                        </table>
                        <p t-if="vals['message']" style="white-space: pre-line; border-left: 3px solid #1d5fa8; padding: 6px 10px; background: #f5f8fc;" t-out="vals['message']"/>
                        <table class="table table-sm" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #eef3f9;">
                                    <th>Date<br/><small>التاريخ</small></th>
                                    <th>Invoice<br/><small>الفاتورة</small></th>
                                    <th>Reference<br/><small>المرجع</small></th>
                                    <th>Due Date<br/><small>تاريخ الاستحقاق</small></th>
                                    <th class="text-end" style="text-align: right;">Days Late<br/><small>أيام التأخير</small></th>
                                    <th class="text-end" style="text-align: right;">Amount<br/><small>المبلغ</small></th>
                                    <th class="text-end" style="text-align: right;">Open<br/><small>المتبقي</small></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="vals['rows']" t-as="r" t-att-style="'color: #c43d3d;' if r['overdue'] else None">
                                    <td><t t-out="r['date']"/></td>
                                    <td><t t-out="r['move']"/></td>
                                    <td><t t-out="r['ref']"/></td>
                                    <td><t t-out="r['due']"/></td>
                                    <td style="text-align: right;"><t t-out="r['days'] or ''"/></td>
                                    <td style="text-align: right;"><t t-out="'{:,.2f}'.format(r['amount'])"/></td>
                                    <td style="text-align: right;"><t t-out="'{:,.2f}'.format(r['residual'])"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width: 100%; margin-top: 12px; border-collapse: collapse; text-align: center;">
                            <tr style="background: #eef3f9; font-weight: bold;">
                                <td t-foreach="vals['buckets']" t-as="b" style="padding: 6px; border: 1px solid #dfe6ee;"><t t-out="b[0]"/></td>
                                <td style="padding: 6px; border: 1px solid #dfe6ee;">Total Due | الإجمالي</td>
                            </tr>
                            <tr>
                                <td t-foreach="vals['buckets']" t-as="b" style="padding: 6px; border: 1px solid #dfe6ee;"><t t-out="'{:,.2f}'.format(b[1])"/></td>
                                <td style="padding: 6px; border: 1px solid #dfe6ee; font-weight: bold;"><t t-out="cur.symbol"/> <t t-out="'{:,.2f}'.format(vals['total'])"/></td>
                            </tr>
                        </table>
                        <p style="margin-top: 14px; color: #6b7a8c;">Overdue amount <span>| المبلغ المتأخر</span>: <strong><t t-out="cur.symbol"/> <t t-out="'{:,.2f}'.format(vals['overdue'])"/></strong></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
