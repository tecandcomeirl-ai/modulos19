<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_consulta_wizard_form" model="ir.ui.view">
        <field name="name">sunat.consulta.wizard.form</field>
        <field name="model">sunat.consulta.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Comprobante a consultar">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="ruc_emisor"/>
                        <field name="doc_code"/>
                        <field name="series"/>
                        <field name="number"/>
                        <field name="issue_date"/>
                        <field name="amount"/>
                    </group>
                    <group string="Resultado" invisible="not estado_cp">
                        <field name="estado_cp" widget="badge"/>
                        <field name="estado_ruc"/>
                        <field name="cond_domi"/>
                        <field name="observaciones"/>
                    </group>
                </group>
                <footer>
                    <button name="action_consult" string="Consultar en SUNAT" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sunat_consulta_wizard" model="ir.actions.act_window">
        <field name="name">Consultar comprobante</field>
        <field name="res_model">sunat.consulta.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sunat_consulta_log_list" model="ir.ui.view">
        <field name="name">sunat.consulta.log.list</field>
        <field name="model">sunat.consulta.log</field>
        <field name="arch" type="xml">
            <list decoration-success="estado_cp in ('1','3')" decoration-danger="estado_cp in ('0','2','4')">
                <field name="date"/>
                <field name="ruc_emisor"/>
                <field name="doc_code"/>
                <field name="series"/>
                <field name="number"/>
                <field name="issue_date"/>
                <field name="amount"/>
                <field name="estado_cp"/>
                <field name="estado_ruc"/>
                <field name="cond_domi"/>
                <field name="move_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sunat_consulta_log_form" model="ir.ui.view">
        <field name="name">sunat.consulta.log.form</field>
        <field name="model">sunat.consulta.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/><field name="user_id"/><field name="move_id"/>
                            <field name="ruc_emisor"/><field name="doc_code"/>
                            <field name="series"/><field name="number"/>
                            <field name="issue_date"/><field name="amount"/>
                        </group>
                        <group>
                            <field name="estado_cp"/><field name="estado_ruc"/>
                            <field name="cond_domi"/><field name="observaciones"/>
                        </group>
                    </group>
                    <field name="response"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sunat_consulta_log" model="ir.actions.act_window">
        <field name="name">Historial de consultas</field>
        <field name="res_model">sunat.consulta.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sunat_consulta" name="Consultar comprobante" parent="l10n_pe_sunat_beta.menu_sunat_root"
              action="action_sunat_consulta_wizard" sequence="40"/>
    <menuitem id="menu_sunat_consulta_log" name="Historial de consultas" parent="l10n_pe_sunat_beta.menu_sunat_root"
              action="action_sunat_consulta_log" sequence="50"/>
</odoo>
