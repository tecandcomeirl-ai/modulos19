<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sunat" model="ir.ui.view">
        <field name="name">res.company.form.sunat</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SUNAT" name="sunat">
                    <group>
                        <group string="Ambiente y credenciales SOL">
                            <field name="sunat_env"/>
                            <field name="sunat_sol_user"/>
                            <field name="sunat_sol_password" password="True"/>
                            <field name="sunat_ubigeo"/>
                            <field name="sunat_estab_code"/>
                        </group>
                        <group string="Certificado digital">
                            <field name="sunat_cert" filename="sunat_cert_filename"/>
                            <field name="sunat_cert_filename" invisible="1"/>
                            <field name="sunat_cert_password" password="True"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
