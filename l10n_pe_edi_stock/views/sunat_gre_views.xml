        <field name="model">sunat.gre</field>
        <field name="inherit_id" ref="l10n_pe_sunat_gre.view_sunat_gre_form"/>
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <field name="related_doc_number" readonly="1" invisible="not related_doc_number"/>
