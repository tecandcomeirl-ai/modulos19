<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_apisperu_log_list" model="ir.ui.view">
        <field name="name">apisperu.log.list</field>
        <field name="model">apisperu.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" decoration-danger="not success">
                <field name="date"/>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="masked_number"/>
                <field name="success"/>
                <field name="error_code"/>
                <field name="message"/>
                <field name="duration_ms"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_apisperu_log_search" model="ir.ui.view">
        <field name="name">apisperu.log.search</field>
        <field name="model">apisperu.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="failed" string="Con error" domain="[('success','=',False)]"/>
                <filter name="ok" string="Correctas" domain="[('success','=',True)]"/>
                <group>
                    <filter name="by_user" string="Usuario" context="{'group_by':'user_id'}"/>
                    <filter name="by_kind" string="Tipo" context="{'group_by':'kind'}"/>
                    <filter name="by_day" string="Día" context="{'group_by':'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apisperu_log" model="ir.actions.act_window">
        <field name="name">Historial de consultas</field>
        <field name="res_model">apisperu.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_apisperu_log" name="Historial de consultas" parent="menu_apisperu_root"
              action="action_apisperu_log" sequence="20" groups="base.group_system"/>
</odoo>
